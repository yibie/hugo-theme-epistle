{
  "name": "epistle-guestbook-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "test:hugo": "hugo --source exampleSite --themesDir ../.. --destination /tmp/epistle-guestbook-build && grep -q 'class=\"letter-guestbook-cta\"' /tmp/epistle-guestbook-build/posts/about-that-afternoon/index.html && grep -q 'class=\"page-guestbook\"' /tmp/epistle-guestbook-build/guestbook/index.html"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22"
  }
}
